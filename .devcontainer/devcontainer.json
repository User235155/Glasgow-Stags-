{
  "name": "Glasgow Stags",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Glasgow Stags", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "npm install --no-audit --no-fund",
  "postAttachCommand": "npm run demo",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
