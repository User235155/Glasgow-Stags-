# --- Admin login -----------------------------------------------------------
# Password the committee uses to sign in at /admin. Pick something long.
ADMIN_PASSWORD=
# Optional: secret used to sign login cookies. Defaults to ADMIN_PASSWORD.
SESSION_SECRET=

# --- Database --------------------------------------------------------------
# Local development uses a SQLite file. In production use a free Turso
# database (https://turso.tech): libsql://your-db.turso.io + an auth token.
DATABASE_URL=file:data/stags.db
DATABASE_AUTH_TOKEN=

# --- Online payments (Stripe) ----------------------------------------------
# Leave blank to hide online payments. Use test keys (sk_test_...) first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL of the site, used for Stripe return links (no trailing slash).
SITE_URL=http://localhost:3000
